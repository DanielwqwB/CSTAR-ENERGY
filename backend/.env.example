HOST=127.0.0.1
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Legacy anon keys also work via SUPABASE_ANON_KEY.
# Only needed for protected admin user creation and the development-only seeder.
# Never expose a service-role key to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Enable Anonymous Sign-Ins in Supabase Auth to use Open demo workspace.
DEMO_ACCESS=false
# Enable behind HTTPS:
COOKIE_SECURE=false
# Optional seeder settings; keep credentials in your local environment/secret store.
ENABLE_DEV_ADMIN_SEEDER=false
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
