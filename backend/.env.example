HOST=127.0.0.1
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Legacy anon keys also work via SUPABASE_ANON_KEY.
# No service_role or secret key is needed; database requests use each user's session.
# Enable Anonymous Sign-Ins in Supabase Auth to use Open demo workspace.
DEMO_ACCESS=false
# Enable behind HTTPS:
COOKIE_SECURE=false
